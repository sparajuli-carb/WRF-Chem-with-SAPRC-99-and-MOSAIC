&share
 wrf_core = 'ARW',
 max_dom = 3,
 start_date = '2021-05-01_00:00:00','2021-05-01_00:00:00','2021-05-01_00:00:00',
 end_date   = '2021-08-31_23:00:00','2021-08-31_23:00:00','2021-08-31_23:00:00',
 interval_seconds = 3600,
 io_form_geogrid = 2,
/

&geogrid
 parent_id         =   1,   1,   2,
 parent_grid_ratio =   1,   3,   2,

 i_parent_start    =   1,  34, 24,
 j_parent_start    =   1,  10, 16,

 e_we              =  80,  97, 101,
 e_sn              =  90,  91, 91,

 geog_data_res = 'default','default','default',

 dx = 12000,
 dy = 12000,

 map_proj = 'lambert',
 ref_lat   = 36.713223,
 ref_lon   = -119.052849,
 truelat1  = 30.0,
 truelat2  = 60.0,
 stand_lon = -120.5,

 geog_data_path = '/data/mmb/raqm/work/users/sparajul/geog_inputs/WPS_GEOG'
/

&ungrib
 out_format = 'WPS',
 prefix = 'ERA5',
/

&metgrid
 fg_name = 'ERA5',
 io_form_metgrid = 2,
/
